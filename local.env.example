# Copy to local.env (git-ignored) and `source local.env` before running tests.
export VR_ROMDIR="/absolute/path/to/dir/containing/vr.zip"
export VR_SATURN_CUE="/absolute/path/to/Virtua Racing (Europe).cue"
# For the second set (PS2 Tracks) only; leave it out with only the Saturn disc (.cue, .bin or plain .iso):
# export VR_PS2_DISC="/absolute/path/to/Sega Ages 2500 Series Vol. 8 - Virtua Racing - FlatOut (Japan).cue"
# export VR_OUT="/absolute/path/for/scratch/output"   # default: <repo>/out
# The reference sets (README.md, "Reference sets"; tests/reference_sets.py): a gate whose set is absent skips, and fails with
# VR_REQUIRE_REFERENCE_SETS=1. Each names a directory holding vr.zip, model1io.zip and m1comm.zip.
# export VR_PRE_WEATHER_SET="/abs/path"   # `python -m vrtools build` of main at 142acd8 (v0.3's game; tag v0.3)
# export VR_RELEASED_SET="/abs/path"      # the same set as VR_PRE_WEATHER_SET
# export VR_P75_SET="/abs/path"           # LOCAL ONLY: the owner's approved storm prototype (out/p75storm); cannot be rebuilt
# export VR_MAIN_SET="/abs/path"          # `python -m vrtools build` of add9799 (main without Phase 32)
# export VR_V04_SET="/abs/path"           # `python -m vrtools build` of v0.4's source 19ac53c (the streaming rain's comparisons)
# export VR_REQUIRE_REFERENCE_SETS=1      # our release runs: a missing reference set fails
